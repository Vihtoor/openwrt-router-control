    <string name="dns_desc_cloudflare">Один із найшвидших публічних DNS-провайдерів у світі з акцентом на конфіденційність.</string>
    <string name="dns_cloudflare_default">Базовий (швидкий доступ та приватність)</string>
    <string name="dns_cloudflare_malware">Захист від шкідливого програмного забезпечення (Malware Block)</string>
    <string name="dns_cloudflare_family">Сімейний (блокування шкідливого ПЗ + контенту для дорослих + SafeSearch)</string>
    <string name="dns_desc_opendns">Один із найстаріших і найнадійніших сервісів, що належить компанії Cisco.</string>
    <string name="dns_opendns_home">Базовий (Home/без фільтрації)</string>
    <string name="dns_opendns_family">Сімейний (Family Shield/передвстановлена фільтрація)</string>
    <string name="dns_opendns_family_desc">Підходить для роутерів, фільтрує контент для дорослих без створення облікового запису.</string>
    <string name="dns_desc_cleanbrowsing">Спеціалізований сервіс орієнтований виключно на блокування небажаного контенту.</string>
    <string name="dns_cleanbrowsing_security">Фільтр безпеки (Security Filter)</string>
    <string name="dns_cleanbrowsing_adult">Дорослий фільтр (Adult Filter)</string>
    <string name="dns_cleanbrowsing_family">Сімейний фільтр (Family Filter)</string>
    <string name="dns_cleanbrowsing_family_desc">Блокує проксі, VPN-тунелі, порнографію та жорстко включає безпечний пошук у Google/YouTube.</string>
    <string name="dns_desc_adguard">Найкращий вибір для тих, хто хоче позбутися реклами на рівні мережевих запитів.</string>
    <string name="dns_adguard_default">Базовий (блокування реклами, трекерів та фішингу)</string>
    <string name="dns_adguard_family">Сімейний (базовий + контент для дорослих + SafeSearch)</string>
    <string name="dns_adguard_unfiltered">Нефільтруючий (просто швидкий та надійний сервіс)</string>
    <string name="dns_desc_controld">Сучасний та дуже гнучкий DNS від творців Windscribe.</string>
    <string name="dns_controld_uncensored">Нефільтруючий (чистий інтернет / Uncensored)</string>
    <string name="dns_controld_ads">Блокування реклами (Ads &amp; Trackers)</string>
    <string name="dns_controld_family">Сімейний (все: реклама + соцмережі + контент для дорослих)</string>
    <string name="dns_desc_quad9">Сервіс із акцентом на кібербезпеку.</string>
    <string name="dns_quad9_default">Стандартний (за замовчуванням / блокування фішингу та малварі)</string>
    <string name="dns_quad9_ecs">Стандартний + ECS-підтримка (з підтримкою ECS)</string>
